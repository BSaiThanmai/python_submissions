# 1. Print all even numbers from 1 to 20
i = 1
while i <= 20:
    if i % 2 == 0:
        print(i)
    i += 1

# 2. Print all odd numbers from 1 to 20
i = 1
while i <= 20:
    if i % 2 != 0:
        print(i)
    i += 1

# 3. Print the first 10 natural numbers
i = 1
while i <= 10:
    print(i)
    i += 1

# 4. Print the first 10 multiples of 5
i = 1
while i <= 10:
    print(5 * i)
    i += 1

# 5. Find the sum of numbers from 1 to N
N = int(input("Enter a number N: "))
i = 1
sum = 0
while i <= N:
    sum += i
    i += 1
print("Sum of numbers from 1 to", N, "is", sum)

# 6. Print the multiplication table of a given number
num = int(input("Enter a number: "))
i = 1
while i <= 10:
    print(num, "x", i, "=", num * i)
    i += 1

# 7. Display battery percentage after each charge until it reaches 100%
battery = 0
while battery < 100:
    battery += 10
    print("Battery:", battery, "%")

# 8. Keep asking for PIN until correct PIN is entered
correct_pin = "1234"
pin = ""
while pin != correct_pin:
    pin = input("Enter PIN: ")
print("Access Granted")
